{
  "name": "@variant-chess/backend",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "node --watch --env-file-if-exists=.env dist/main.js",
    "dev:compile": "tsc -p tsconfig.build.json --watch",
    "start": "node --env-file-if-exists=.env dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@variant-chess/shared-types": "0.0.0",
    "@variant-chess/game-core": "0.0.0",
    "@variant-chess/game-variants": "0.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@variant-chess/game-testkit": "0.0.0"
  }
}
